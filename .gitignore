# ── 不进本仓的内容 ──
#
# docs/ 整个排除：内部规划与现场记录，含客户信息与内部运维细节，不公开。
docs/

# 构建产物
dist/
release/
*.exe
# ★ 只忽略根目录下编译出来的二进制。
#   早先这里写的是裸 `netkitd`，它把 backend/cmd/netkitd/ **目录**也一起忽略了，
#   结果推上去的仓库没有程序入口、编不出可执行文件。
/netkitd
/backend/netkitd

# 密钥：任何情况下都不进仓库
keys/
*.key
*.pem

# 界面依赖与构建产物
ui/node_modules/
ui/build/yuhox-kit/
